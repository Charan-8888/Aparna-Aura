SECRET_KEY=your_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Configure a real SMTP/email provider before production. Console mail is used only with DEBUG=True.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@your-domain.example
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
# For Gmail, use a Google App Password; never use your normal account password.
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_USE_TLS=True

DB_NAME=aparna_aura
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Set a unique 32+ character secret in Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=your_32_character_or_longer_webhook_secret

# Google OAuth 2.0 web client ID (never place a Google client secret in the frontend)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
